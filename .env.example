# CONFIGURACIÓN SUPABASE (Opcional para modo nube, el sistema tiene almacenamiento reactivo local por defecto)
NEXT_PUBLIC_SUPABASE_URL=https://yubaienethtfubcozehm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<CONFIGURAR_EN_ENTORNO>
SUPABASE_SERVICE_ROLE_KEY=<CONFIGURAR_SOLO_EN_SERVIDOR>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<CONFIGURAR_EN_ENTORNO>
# CONFIGURACIÓN PROVEEDOR IA (OpenCode Go)
OPENCODE_GO_API_KEY=<CONFIGURAR_EN_ENTORNO>
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash-vision-exp
# Biblioteca normativa de la empresa habilitada (solo servidor)
ANYTHINGLLM_WORKSPACE=adquisiciones-ende
# URL HTTPS completa del servicio independiente /api/docx/preview
DOCX_PREVIEW_URL=
DOCX_PREVIEW_KEY=
